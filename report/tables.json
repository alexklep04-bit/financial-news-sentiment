  "rows": [
   [
    "JPMorgan",
    "\\bJ\\.?\\s?P\\.?\\s?Morgan\\b|\\bJPMorgan\\b|\\bJamie Dimon\\b|\\$JPM\\b"
   ],
   [
    "Goldman Sachs",
    "\\bGoldman\\b|\\$GS\\b|\\bLloyd Blankfein\\b|\\bDavid Solomon\\b"
   ],
   [
    "BlackRock",
    "\\bBlack[Rr]ock\\b|\\bLarry Fink\\b|\\$BLK\\b"
   ],
   [
    "Vanguard (not American Vanguard, Vanguard Health, ...)",
    "(?<!American )\\bVanguard\\b(?!\\s(?:Natural|Health|Cellular|Car|Minerals))"
   ],
   [
    "Citadel",
    "\\bCitadel\\b|\\bKen Griffin\\b"
   ],
   [
    "Noise: bank acts as a broker",
    "\\b(?:upgrade|downgrade|initiat|reiterat|maintain|resum|assum)\\w*\\b | \\bprice target\\b | \\b(?:at|by|from)\\s+FIRM\\b | ^FIRM(?:'s)?:?\\s+(?:sees|says|likes|...)\\b"
   ],
   [
    "Noise: portfolio list",
    "\\b(?:Buys|Sells)\\b.*(?:\\.\\.\\.|…)\\s*$|\\b(?:Buys|Sells)\\b[^,]*,[^,]*,"
   ],
   [
    "Noise: event name",
    "\\b(?:conference|forum|symposium|summit)\\b"
   ],
   [
    "Percentages",
    "NUM\\s?(?:%|percent|pct)"
   ],
   [
    "Money amounts",
    "CUR\\s?NUM(?:\\s?MAG)?\\b|NUM\\s?MAG?\\s?CUR"
   ],
   [
    "Years / quarters",
    "\\b(?:19|20)\\d{2}\\b   \\b(?:Q[1-4]|(?:first|second|third|fourth)[- ]quarter)\\b"
   ],
   [
    "Cashtags in tweets",
    "\\$([A-Za-z]{1,6})\\b  ->  \\1"
   ]
  ],
  "note": "FIRM = (?:J\\.?\\s?P\\.?\\s?Morgan|JPMorgan(?: Chase)?|Goldman(?: Sachs)?|BlackRock|Vanguard|Citadel), NUM = \\d+(?:[.,]\\d+)*, CUR = EUR, USD, SEK, $, € and other currencies, MAG = mn, million, bn, thousand, ... The noise rules and the number patterns are case-insensitive.",
